# Gemini is optional. Without it, ECHO still has persistent local memory and local synthesis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Supabase persistence. If absent, ECHO uses .data/memories.json.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

ECHO_DEMO_USER_ID=demo-user-01
ECHO_DEMO_PROJECT_ID=echo-demo
